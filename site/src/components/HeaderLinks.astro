---
// Replaces Starlight's SocialIcons: the main pages as text links, then the usual
// social icons. The text links only show on wide screens; on narrower ones the same
// pages lead the sidebar menu.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { url } from '../lib/url';

const links = [
	['getting-started/', 'Download'],
	['nina/', 'N.I.N.A.'],
	['which-catalogue/', 'Which catalogue?'],
	['faq/', 'FAQ'],
];
const current = Astro.url.pathname;
---

<nav class="header-links" aria-label="Main pages">
	{
		links.map(([to, text]) => {
			const href = url(to);
			return (
				<a href={href} aria-current={current === href ? 'page' : undefined}>
					{text}
				</a>
			);
		})
	}
</nav>
<Default />

<style>
	.header-links {
		display: none;
	}
	@media (min-width: 72rem) {
		.header-links {
			display: flex;
			align-items: center;
			gap: 1.25rem;
			margin-inline-end: 0.5rem;
		}
	}
	.header-links a {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.header-links a:hover,
	.header-links a[aria-current='page'] {
		color: var(--sl-color-text-accent);
	}
</style>
